# ==============================================================================
# TrustLens AI Clinical Safety Assistant - Environment Configuration
# ==============================================================================

# 1. Google Gemini Clinical AI Engine
EXPO_PUBLIC_GEMINI_API_KEY=

# 2. Google Cloud Firestore Database (User Profiles & Scan History)
EXPO_PUBLIC_FIREBASE_PROJECT_ID=trustlens-ai
EXPO_PUBLIC_FIREBASE_API_KEY=

# 3. Cloudflare Storage (Cloudflare R2 S3-Compatible Object Storage)
EXPO_PUBLIC_CLOUDFLARE_R2_ACCOUNT_ID=
EXPO_PUBLIC_CLOUDFLARE_R2_BUCKET_NAME=trustlens-scans
EXPO_PUBLIC_CLOUDFLARE_R2_ACCESS_KEY_ID=
EXPO_PUBLIC_CLOUDFLARE_R2_SECRET_ACCESS_KEY=
EXPO_PUBLIC_CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-trustlens-scans.r2.dev
EXPO_PUBLIC_CLOUDFLARE_WORKER_URL=https://upload.trustlens.workers.dev
